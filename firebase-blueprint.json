{
  "entities": {
    "ApplicationLink": {
      "title": "Application Link Config",
      "description": "Unique form link generated by an immigration officer for public applicant submissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "token": { "type": "string" },
        "officerId": { "type": "string" },
        "officerName": { "type": "string" },
        "officerBadge": { "type": "string" },
        "officerStation": { "type": "string" },
        "applicationType": { "type": "string" },
        "townshipName": { "type": "string" },
        "customNote": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "token", "officerId", "applicationType"]
    },
    "ApplicationSubmission": {
      "title": "Public Application Submission",
      "description": "Application submitted by a citizen via a unique link, routed directly to the issuing officer.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "submissionRef": { "type": "string" },
        "linkToken": { "type": "string" },
        "officerId": { "type": "string" },
        "officerEmail": { "type": "string" },
        "applicationType": { "type": "string" },
        "applicantName": { "type": "string" },
        "applicantPhone": { "type": "string" },
        "applicantNrc": { "type": "string" },
        "applicantAddress": { "type": "string" },
        "fatherName": { "type": "string" },
        "motherName": { "type": "string" },
        "dob": { "type": "string" },
        "gender": { "type": "string" },
        "status": { "type": "string" },
        "officerNotes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "submissionRef", "linkToken", "officerId", "applicationType", "applicantName"]
    }
  },
  "firestore": {
    "/application_links/{linkId}": {
      "schema": { "$ref": "#/entities/ApplicationLink" },
      "description": "Stores generated link configurations created by officers."
    },
    "/application_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/ApplicationSubmission" },
      "description": "Stores applications submitted by citizens routed to specific officers."
    }
  }
}
