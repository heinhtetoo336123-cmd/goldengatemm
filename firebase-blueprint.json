{
  "entities": {
    "AuthorizedOfficer": {
      "title": "Authorized Immigration Officer",
      "description": "Allowlisted officer email and role verified before granting access to the officer workspace.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 180 },
        "role": { "type": "string", "enum": ["ADMIN", "OFFICER", "INSPECTOR", "SUPERVISOR"] },
        "active": { "type": "boolean" },
        "addedBy": { "type": "string", "maxLength": 180 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "active", "createdAt"]
    },
    "ApplicationLink": {
      "title": "Application Link Config",
      "description": "Unique form link generated by an immigration officer for public applicant submissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "token": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "officerId": { "type": "string", "maxLength": 128 },
        "officerEmail": { "type": "string", "maxLength": 180 },
        "officerName": { "type": "string", "maxLength": 120 },
        "officerBadge": { "type": "string", "maxLength": 64 },
        "officerStation": { "type": "string", "maxLength": 200 },
        "applicationType": { "type": "string", "enum": ["NRC_APP", "HOUSEHOLD_APP", "DECEASED_REMOVAL", "BIRTH_ADDITION"] },
        "townshipName": { "type": "string", "maxLength": 160 },
        "customNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["ACTIVE", "EXPIRED", "REVOKED"] },
        "submissionCount": { "type": "number" }
      },
      "required": ["id", "token", "officerId", "officerEmail", "officerName", "officerBadge", "officerStation", "applicationType", "townshipName", "status", "createdAt", "expiresAt"]
    },
    "ApplicationSubmission": {
      "title": "Public Application Submission",
      "description": "Application submitted by a citizen via a unique link, routed directly to the issuing officer.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "submissionRef": { "type": "string", "maxLength": 64 },
        "linkToken": { "type": "string", "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "officerId": { "type": "string", "maxLength": 128 },
        "officerEmail": { "type": "string", "maxLength": 180 },
        "applicationType": { "type": "string", "enum": ["NRC_APP", "HOUSEHOLD_APP", "DECEASED_REMOVAL", "BIRTH_ADDITION"] },
        "applicantName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "applicantPhone": { "type": "string", "minLength": 5, "maxLength": 40 },
        "applicantNrc": { "type": "string", "maxLength": 80 },
        "applicantAddress": { "type": "string", "maxLength": 400 },
        "fatherName": { "type": "string", "maxLength": 160 },
        "motherName": { "type": "string", "maxLength": 160 },
        "dob": { "type": "string", "maxLength": 40 },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE"] },
        "bloodGroup": { "type": "string", "maxLength": 16 },
        "ethnicityReligion": { "type": "string", "maxLength": 120 },
        "nrcSubCategory": { "type": "string", "enum": ["10_YEAR", "18_YEAR", "REPLACEMENT", "NEW"] },
        "householdListNo": { "type": "string", "maxLength": 80 },
        "deceasedPersonName": { "type": "string", "maxLength": 160 },
        "dateOfDeath": { "type": "string", "maxLength": 40 },
        "causeOfDeath": { "type": "string", "maxLength": 240 },
        "childName": { "type": "string", "maxLength": 160 },
        "childDob": { "type": "string", "maxLength": 40 },
        "childGender": { "type": "string", "enum": ["MALE", "FEMALE"] },
        "placeOfBirth": { "type": "string", "maxLength": 200 },
        "attachments": { "type": "array", "description": "Up to 6 uploaded attachment objects with title and compressed dataUrl" },
        "status": { "type": "string", "enum": ["PENDING", "APPROVED", "REJECTED", "REVISION_NEEDED"] },
        "officerNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "submissionRef", "linkToken", "officerId", "officerEmail", "applicationType", "applicantName", "applicantPhone", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/authorized_officers/{officerEmail}": {
      "schema": { "$ref": "#/entities/AuthorizedOfficer" },
      "description": "Allowlisted immigration officer emails and RBAC roles managed by admins."
    },
    "/application_links/{linkId}": {
      "schema": { "$ref": "#/entities/ApplicationLink" },
      "description": "Stores generated link configurations created by officers, keyed by token."
    },
    "/application_submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/ApplicationSubmission" },
      "description": "Stores applications submitted by citizens routed directly to issuing officers."
    }
  }
}
