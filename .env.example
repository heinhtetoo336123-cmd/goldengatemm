# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_CLIENT_ID: Google OAuth 2.0 Web Client ID (Optional extra GIS button)
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID.apps.googleusercontent.com"

# Clean-Slate Firebase Web App Configuration (Get these from your new Firebase Project Settings -> Web App)
VITE_FIREBASE_API_KEY="YOUR_NEW_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_NEW_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_NEW_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_NEW_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_NEW_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_NEW_FIREBASE_APP_ID"
# Optional: Leave empty to use the default "(default)" Firestore database
VITE_FIREBASE_DATABASE_ID=""
